            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Contract carry-forward rule",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A price covers the auction season and later seasons until the earliest of: the player's next auction − 1, the next mega auction − 1 (2014, 2018, 2022, 2025), or 2026. Later seasons count only while the player still plays for that team.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Assumptions and limits",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Retained, traded and replacement players have no auction price: 'Unpriced', excluded from value measures.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• 2013 prices in US$, converted at ₹54/$ (parameter UsdInrRate2013).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Base prices exist only for 2025–26; earlier, a buy at that era's minimum base (₹10/20 lakh) counts as base-price.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• 99.0% of auction spend (₹3,237 of ₹3,269 Cr) is matched to a Cricsheet player; most of the 66 unmatched buys never played an IPL match.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Matches = playing-XI appearances (Cricsheet), incl. impact-player substitutes.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The weights are a judgement call; the runs-only and wickets-only measures tell the same story at the top of the tables.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
