table DimTeamSeason
	lineageTag: 526f7343-9b9a-5da1-aad3-0b28337a21a4

	column TeamSeasonKey
		dataType: string
		isHidden
		lineageTag: b186a7c6-c345-5dc2-8a2f-373a16a5ecd9
		summarizeBy: none
		sourceColumn: TeamSeasonKey

		annotation SummarizationSetBy = User

	column TeamSeasonLabel
		dataType: string
		lineageTag: 80a1d995-9dca-587a-a263-5ab923a597b3
		summarizeBy: none
		sourceColumn: TeamSeasonLabel

		annotation SummarizationSetBy = User

	column TeamKey
		dataType: string
		isHidden
		lineageTag: 8e690f1f-b133-520a-9e30-485af3bf39af
		summarizeBy: none
		sourceColumn: TeamKey

		annotation SummarizationSetBy = User

	column Season
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: af763c82-89ba-5d21-a8e6-852af123117b
		summarizeBy: none
		sourceColumn: Season

		annotation SummarizationSetBy = User

	column TeamColour
		dataType: string
		isHidden
		lineageTag: 1cd167df-87d5-5341-9731-eecbb465d649
		summarizeBy: none
		sourceColumn: TeamColour

		annotation SummarizationSetBy = User

	partition DimTeamSeason = m
		mode: import
		queryGroup: Model
		source =
				// One row per franchise per season it played: lets one scatter dot represent a team-season.
				let
				    Played = Table.Distinct(Table.SelectColumns(stg_Appearances, {"TeamKey", "Season"})),
				    Teams = Table.Distinct(Table.SelectColumns(stg_TeamMap, {"TeamKey", "TeamColour"}), {"TeamKey"}),
				    WithColour = Table.ExpandTableColumn(Table.NestedJoin(Played, {"TeamKey"}, Teams, {"TeamKey"}, "T", JoinKind.LeftOuter), "T", {"TeamColour"}),
				    WithKey = Table.AddColumn(WithColour, "TeamSeasonKey", each [TeamKey] & "|" & Text.From([Season]), type text),
				    WithLabel = Table.AddColumn(WithKey, "TeamSeasonLabel", each [TeamKey] & " " & Text.From([Season]), type text),
				    Final = Table.SelectColumns(WithLabel, {"TeamSeasonKey", "TeamSeasonLabel", "TeamKey", "Season", "TeamColour"}),
				    Typed = Table.TransformColumnTypes(Final, {{"Season", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

