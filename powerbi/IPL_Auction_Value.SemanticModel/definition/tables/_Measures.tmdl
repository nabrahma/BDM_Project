	measure 'Top Steal Label' =
			VAR t =
			    TOPN ( 1,
			        FILTER ( ADDCOLUMNS ( VALUES ( DimPlayer[PlayerName] ), "@v", [Value Index (min 5 matches)] ), NOT ISBLANK ( [@v] ) ),
			        [@v], DESC )
			RETURN
			    CONCATENATEX ( t, DimPlayer[PlayerName] & " · " & FORMAT ( [@v], "0.0" ) & "×", ", " )
		displayFolder: Value
		lineageTag: 23798ffd-7aae-5d14-ab37-5f5e94943eac

	measure 'Most Overpaid Label' =
			VAR t =
			    TOPN ( 1,
			        FILTER ( ADDCOLUMNS ( VALUES ( DimPlayer[PlayerName] ), "@o", [Overpay Cr (min 5 matches)] ), [@o] > 0 ),
			        [@o], DESC )
			RETURN
			    CONCATENATEX ( t, DimPlayer[PlayerName] & " · ₹" & FORMAT ( [@o], "0.0" ) & " Cr", ", " )
		displayFolder: Value
		lineageTag: ce93ad92-12e6-5c2f-9398-13097a4580b3

	measure 'Best Team Label' =
			VAR t =
			    TOPN ( 1,
			        FILTER ( ADDCOLUMNS ( VALUES ( DimTeam[ShortCode] ), "@v", [Value Index] ), NOT ISBLANK ( [@v] ) ),
			        [@v], DESC )
			RETURN
			    CONCATENATEX ( t, DimTeam[ShortCode] & " · " & FORMAT ( [@v], "0.00" ), ", " )
		displayFolder: Value
		lineageTag: 57d0f279-778c-5db6-95b2-d1d7750f96d0

	measure 'Worst Team Label' =
			VAR t =
			    TOPN ( 1,
			        FILTER ( ADDCOLUMNS ( VALUES ( DimTeam[ShortCode] ), "@v", [Value Index] ), NOT ISBLANK ( [@v] ) ),
			        [@v], ASC )
			RETURN
			    CONCATENATEX ( t, DimTeam[ShortCode] & " · " & FORMAT ( [@v], "0.00" ), ", " )
		displayFolder: Value
		lineageTag: c25622ff-ac14-5cbb-ba53-a968fbd818fc

	measure 'Best Role Label' =
			VAR t =
			    TOPN ( 1,
			        FILTER (
			            ADDCOLUMNS ( FILTER ( VALUES ( DimPlayer[Role] ), DimPlayer[Role] <> "Unknown" ), "@v", [Value Index] ),
			            NOT ISBLANK ( [@v] ) ),
			        [@v], DESC )
			RETURN
			    CONCATENATEX ( t, DimPlayer[Role] & " · " & FORMAT ( [@v], "0.00" ), ", " )
		displayFolder: Value
		lineageTag: b8ca9a5a-3e4d-52a3-a01d-8bc0da33ab1a

	measure 'Players In Data' = COUNTROWS ( DimPlayer )
		formatString: #,0
		displayFolder: QA
		lineageTag: a5edfe64-3bf1-5558-84e1-b38b3c5ce346

	measure 'Seasons Covered' = DISTINCTCOUNT ( FactTeamMatch[Season] )
		formatString: #,0
		displayFolder: QA
		lineageTag: 54256091-eae8-5a21-9579-a5fecdc09e5c

	measure 'QA 2026 Buys' = CALCULATE ( [Players Bought], DimSeason[Season] = 2026 )
		formatString: #,0
		displayFolder: QA
		lineageTag: c1329c0a-9348-5fd9-9ae9-cd2276198857

	measure 'QA 2026 Spend Cr' = CALCULATE ( [Total Auction Spend Cr], DimSeason[Season] = 2026 )
		formatString: ₹#,0.00 Cr
		displayFolder: QA
		lineageTag: d581e4fe-e23f-507b-a2e1-36f368de4d4b

	measure 'Team Wins' = SUM ( FactTeamMatch[Won] )
		formatString: #,0
		displayFolder: Team
		lineageTag: 97aaadf4-8909-5c7f-9be9-fb5bc7d56286

	measure 'Team Results' = COUNTROWS ( FactTeamMatch ) - SUM ( FactTeamMatch[NoResult] )
		formatString: #,0
		displayFolder: Team
		lineageTag: 247a7629-1437-56ec-9c3b-2cb77a47790e

	measure 'Win %' = DIVIDE ( [Team Wins], [Team Results] )
		formatString: 0%
		displayFolder: Team
		lineageTag: 85107d79-81ce-51e3-b09a-15eceadaa3ca

	measure 'Team Spend Cr' = [Spend Cr]
		formatString: ₹#,0.0 Cr
		displayFolder: Team
		lineageTag: 6e8a5fd5-066b-5176-b3e2-94f5fb1bd040

	measure 'QA Matches' = DISTINCTCOUNT ( FactTeamMatch[MatchID] )
		formatString: #,0
		displayFolder: QA
		lineageTag: 191fa43d-97e0-5599-bba3-2bb76e41135e

	measure 'QA League Value Index' = CALCULATE ( [Value Index], REMOVEFILTERS ( DimTeam ), REMOVEFILTERS ( DimPlayer ) )
		formatString: 0.00
		displayFolder: QA
		lineageTag: 58d28979-93e9-5d04-9847-34a8220026df

	measure 'QA Bad Prices' = 0 + COUNTROWS ( FILTER ( FactAuction, ISBLANK ( FactAuction[PriceCr] ) || FactAuction[PriceCr] <= 0 ) )
		formatString: #,0
		displayFolder: QA
		lineageTag: 55856cfe-07a7-5cf4-abdb-5bd96a18cb4d

	measure 'QA Team Keys' = CONCATENATEX ( FILTER ( VALUES ( DimTeam[TeamKey] ), CALCULATE ( COUNTROWS ( FactPlayerSeason ) ) + CALCULATE ( COUNTROWS ( FactAuction ) ) > 0 ), DimTeam[TeamKey], ", ", DimTeam[TeamKey], ASC )
		displayFolder: QA
		lineageTag: e86473f1-ed5c-59d0-8fd9-6f344387ba0b

	measure 'QA Unmapped Team Rows' = 0 + COUNTROWS ( FILTER ( FactAuction, ISBLANK ( FactAuction[TeamKey] ) ) ) + COUNTROWS ( FILTER ( FactTeamMatch, ISBLANK ( FactTeamMatch[TeamKey] ) ) )
		formatString: #,0
		displayFolder: QA
		lineageTag: 33aad17b-9d32-5e08-a2f4-5edc4a94f095

	measure 'QA Avg Win %' = AVERAGEX ( VALUES ( DimTeam[TeamKey] ), [Win %] )
		formatString: 0.0%
		displayFolder: QA
		lineageTag: bb2a0d32-f8fc-5271-90c5-a244544faec0

	measure 'QA Contract Rows Beyond Mega' =
			-- Contract rows that run past the season before the next mega auction (should be 0).
			0 + COUNTROWS (
			    FILTER (
			        FactPlayerSeason,
			        FactPlayerSeason[PriceSource] = "Auction"
			            && FactPlayerSeason[Season] > SWITCH ( TRUE (),
			                FactPlayerSeason[AuctionSeason] < 2014, 2013,
			                FactPlayerSeason[AuctionSeason] < 2018, 2017,
			                FactPlayerSeason[AuctionSeason] < 2022, 2021,
			                FactPlayerSeason[AuctionSeason] < 2025, 2024,
			                2026 )
			    )
			)
		formatString: #,0
		displayFolder: QA
		lineageTag: c45cd1c5-0dca-55eb-b631-b3e6fa958117

	column Measures
		dataType: string
