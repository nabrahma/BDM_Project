	measure 'Median Priced Price Cr' = CALCULATE ( MEDIAN ( FactPlayerSeason[PriceCr] ), ALL ( FactPlayerSeason ), VALUES ( DimSeason[Season] ), FactPlayerSeason[PriceSource] = "Auction" )
		formatString: ₹#,0.00 Cr
		displayFolder: Value
		lineageTag: 1b3787ab-276a-5361-8317-81ad5a310137

	measure 'Median Priced Impact' = CALCULATE ( MEDIAN ( FactPlayerSeason[ImpactPoints] ), ALL ( FactPlayerSeason ), VALUES ( DimSeason[Season] ), FactPlayerSeason[PriceSource] = "Auction" )
		formatString: #,0
		displayFolder: Value
		lineageTag: 0ce290f3-fc86-5846-b7d9-ec46f7a7abf0

	measure 'Above Median Impact %' =
			-- Share of priced player-seasons whose Impact Points beat that season's median.
			VAR priced = FILTER ( FactPlayerSeason, FactPlayerSeason[PriceSource] = "Auction" )
			RETURN
			    DIVIDE ( COUNTROWS ( FILTER ( priced, FactPlayerSeason[ImpactPoints] >= FactPlayerSeason[MedianImpact] ) ), COUNTROWS ( priced ) )
		formatString: 0%
		displayFolder: Value
		lineageTag: 23af9b39-654b-540c-b1bb-effaaaa71282

	measure 'Overpay Cr (min 5 matches)' = IF ( [Priced Matches] >= 5, [Overpay Cr] )
		formatString: ₹#,0.0 Cr
		displayFolder: Value
		lineageTag: a5b221fd-8b5b-544f-b5ec-5a95c3cd4b56

	measure 'Steal Rank' =
			VAR vi = [Value Index (min 5 matches)]
			RETURN
			    IF (
			        ISBLANK ( vi ), 999,
			        RANKX ( FILTER ( ALLSELECTED ( DimPlayer[PlayerName] ), NOT ISBLANK ( [Value Index (min 5 matches)] ) ), [Value Index (min 5 matches)], vi, DESC, SKIP )
			    )
		formatString: 0
		displayFolder: Value
		lineageTag: 6064a07e-aef1-5fef-9792-63d061334869

	measure 'Overpaid Rank' =
			VAR o = [Overpay Cr (min 5 matches)]
			RETURN
			    IF (
			        ISBLANK ( o ) || o <= 0, 999,
			        RANKX ( FILTER ( ALLSELECTED ( DimPlayer[PlayerName] ), [Overpay Cr (min 5 matches)] > 0 ), [Overpay Cr (min 5 matches)], o, DESC, SKIP )
			    )
		formatString: 0
		displayFolder: Value
		lineageTag: 6e417626-bf0a-5ff0-b3de-a1ecfe90eb14

