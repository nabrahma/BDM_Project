	measure 'Top Run Scorer Runs' = MAXX ( VALUES ( DimPlayer[PlayerID] ), [Runs] )
		formatString: #,0
		displayFolder: Performance
		lineageTag: b3397da2-ec6b-5dde-949c-6ad851ae3ad7

	measure 'Top Run Scorer' =
			VAR best = [Top Run Scorer Runs]
			RETURN
