	measure 'Quadrant Colour' = SWITCH ( SELECTEDVALUE ( FactPlayerSeason[Value Quadrant] ), "Steal", "#D7F0DE", "Star", "#FCF0C8", "Overpaid", "#FADADB", "Passenger", "#EEEEEE", "#FFFFFF" )
