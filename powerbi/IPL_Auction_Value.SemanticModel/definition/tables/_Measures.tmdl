	measure 'Lakh per Point' = DIVIDE ( [Spend Cr] * 100, [Priced Impact] )
		formatString: #,0.00
		displayFolder: Value
		lineageTag: 9a7e798a-4edd-5964-83b4-99f8cda3ecc6

	measure 'League Spend' = CALCULATE ( [Spend Cr], ALL ( FactPlayerSeason ), VALUES ( DimSeason[Season] ) )
		formatString: ₹#,0.0 Cr
		displayFolder: Value
		lineageTag: 3a3e7420-9a66-5976-82c4-d24c0aa1ee5a

	measure 'League Priced Impact' = CALCULATE ( [Priced Impact], ALL ( FactPlayerSeason ), VALUES ( DimSeason[Season] ) )
		formatString: #,0
		displayFolder: Value
		lineageTag: 28af0d09-121d-55e2-9db9-f12c26c93bdc

	measure 'Value Index' =
			-- Share of the league's priced impact divided by share of the league's spend,
			-- computed season by season so each season is judged against its own market.
			-- 1.00 = fair value, above 1 = more output than the money suggests.
			VAR bySeason =
			    ADDCOLUMNS (
			        VALUES ( DimSeason[Season] ),
			        "@impShare", DIVIDE ( [Priced Impact], [League Priced Impact] ),
			        "@spendShare", DIVIDE ( [Spend Cr], [League Spend] )
			    )
			RETURN
			    DIVIDE ( SUMX ( bySeason, [@impShare] ), SUMX ( bySeason, [@spendShare] ) )
		formatString: 0.00
		displayFolder: Value
		lineageTag: 4b134e6d-ee5d-518b-8a22-f06cb68ff53d

	measure 'Fair Value Cr' =
			-- What the output would have cost at that season's league price per Impact Point.
			SUMX (
			    VALUES ( DimSeason[Season] ),
			    DIVIDE ( [Priced Impact] * [League Spend], [League Priced Impact] )
			)
		formatString: ₹#,0.0 Cr
		displayFolder: Value
		lineageTag: 651f60c3-fc5f-5918-a887-4ec3f210f8ee

	measure 'Overpay Cr' = IF ( NOT ISBLANK ( [Spend Cr] ), [Spend Cr] - [Fair Value Cr] )
		formatString: ₹#,0.0 Cr
		displayFolder: Value
		lineageTag: 2e0f801d-23dc-56f4-ae69-7afed6e10b51

	measure 'Surplus Cr' = IF ( NOT ISBLANK ( [Spend Cr] ), [Fair Value Cr] - [Spend Cr] )
		formatString: ₹#,0.0 Cr
		displayFolder: Value
		lineageTag: 6b9c8945-59ec-5d15-906e-0df5d89d324e

	measure 'Value Index (min 5 matches)' = IF ( [Priced Matches] >= 5, [Value Index] )
		formatString: 0.00
		displayFolder: Value
		lineageTag: 4095ab85-81d4-5f01-ba16-6f7a1f28a887

	measure 'Value Quadrant Label' =
			IF ( HASONEVALUE ( FactPlayerSeason[Value Quadrant] ), VALUES ( FactPlayerSeason[Value Quadrant] ),
			    CONCATENATEX ( VALUES ( FactPlayerSeason[Value Quadrant] ), FactPlayerSeason[Value Quadrant], ", " ) )
		displayFolder: Value
		lineageTag: d254951c-6b4f-52a1-8e9e-07c55fbaf3d5

	measure 'Bargain XI Flag' =
			-- 1 when the player is in the Bargain XI: top Value Index per role (4 batters, 1 keeper, 2 all-rounders, 4 bowlers), min 5 priced matches.
			VAR thisPlayer = SELECTEDVALUE ( DimPlayer[PlayerID] )
			VAR thisRole = SELECTEDVALUE ( DimPlayer[Role] )
			VAR slots = SWITCH ( thisRole, "Batter", 4, "Wicket-Keeper", 1, "All-Rounder", 2, "Bowler", 4, 0 )
			VAR eligible =
			    CALCULATETABLE (
			        FILTER (
			            ADDCOLUMNS ( VALUES ( DimPlayer[PlayerID] ), "@vi", [Value Index], "@m", [Priced Matches] ),
			            [@m] >= 5 && NOT ISBLANK ( [@vi] )
			        ),
			        ALLSELECTED ( DimPlayer ),
			        DimPlayer[Role] = thisRole
			    )
			VAR picked = TOPN ( slots, eligible, [@vi], DESC )
			RETURN
			    IF ( NOT ISBLANK ( thisPlayer ) && thisPlayer IN SELECTCOLUMNS ( picked, "id", DimPlayer[PlayerID] ), 1 )
		formatString: 0
		displayFolder: Value
		lineageTag: 24ccbd9d-df2f-5f4a-844c-23932d04f915

	measure 'Overpaid XI Flag' =
			-- 1 when the player is in the Overpaid XI: largest Overpay Cr per role, min 5 priced matches.
			VAR thisPlayer = SELECTEDVALUE ( DimPlayer[PlayerID] )
			VAR thisRole = SELECTEDVALUE ( DimPlayer[Role] )
			VAR slots = SWITCH ( thisRole, "Batter", 4, "Wicket-Keeper", 1, "All-Rounder", 2, "Bowler", 4, 0 )
			VAR eligible =
			    CALCULATETABLE (
			        FILTER (
			            ADDCOLUMNS ( VALUES ( DimPlayer[PlayerID] ), "@over", [Overpay Cr], "@m", [Priced Matches] ),
			            [@m] >= 5 && [@over] > 0
			        ),
			        ALLSELECTED ( DimPlayer ),
			        DimPlayer[Role] = thisRole
			    )
			VAR picked = TOPN ( slots, eligible, [@over], DESC )
			RETURN
			    IF ( NOT ISBLANK ( thisPlayer ) && thisPlayer IN SELECTCOLUMNS ( picked, "id", DimPlayer[PlayerID] ), 1 )
		formatString: 0
		displayFolder: Value
		lineageTag: 453d9191-06f8-5171-9a1c-d5269fdf31ae

	measure 'Teams Played For' = CONCATENATEX ( VALUES ( FactPlayerSeason[TeamKey] ), FactPlayerSeason[TeamKey], ", ", FactPlayerSeason[TeamKey], ASC )
