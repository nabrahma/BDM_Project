	measure 'Total Auction Spend Cr' = SUM ( FactAuction[PriceCr] )
		formatString: ₹#,0.0 Cr
		displayFolder: Money
		lineageTag: 70b2a040-bd08-5efd-9a04-5604447df674

	measure 'Players Bought' = COUNTROWS ( FactAuction )
		formatString: #,0
		displayFolder: Money
		lineageTag: e240d070-502e-57d7-9a89-83d11485dc70

	measure 'Avg Auction Price Cr' = AVERAGE ( FactAuction[PriceCr] )
		formatString: ₹#,0.00 Cr
		displayFolder: Money
		lineageTag: c69dab8d-e6b3-5aa9-9007-23d760734626

	measure 'Median Auction Price Cr' = MEDIAN ( FactAuction[PriceCr] )
		formatString: ₹#,0.00 Cr
		displayFolder: Money
		lineageTag: bdb07151-53b4-5539-b04c-1f32b439b889

	measure 'Top Buy Price Cr' = MAX ( FactAuction[PriceCr] )
		formatString: ₹#,0.0 Cr
		displayFolder: Money
		lineageTag: d0c59ead-e12b-596c-a6e8-6bbfb4a34bd4

	measure 'Top Buy Player' =
			-- One name even when two buys share the top price (ties broken by the auction row key).
			VAR mx = MAX ( FactAuction[PriceCr] )
			VAR top1 = TOPN ( 1, FILTER ( FactAuction, FactAuction[PriceCr] = mx ), FactAuction[AuctionKey], ASC )
			RETURN
			    CONCATENATEX ( top1, RELATED ( DimPlayer[PlayerName] ) & " (" & FactAuction[TeamKey] & ")", ", " )
		displayFolder: Money
		lineageTag: 791dbd2a-6b0f-5699-b2d6-cb57c66a4831

	measure 'Auction Premium %' =
			VAR withBase = FILTER ( FactAuction, NOT ISBLANK ( FactAuction[BasePriceCr] ) )
			VAR paid = SUMX ( withBase, FactAuction[PriceCr] )
			VAR base = SUMX ( withBase, FactAuction[BasePriceCr] )
			RETURN
			    DIVIDE ( paid - base, base )
		formatString: 0%
		displayFolder: Money
		lineageTag: 78f8569f-d065-59df-9612-8316fccc844d

	measure 'Avg Price vs 2013' =
			-- Average price in the latest season in context, as a multiple of the 2013 average.
			VAR latest = MAX ( DimSeason[Season] )
			RETURN
			    DIVIDE (
			        CALCULATE ( [Avg Auction Price Cr], REMOVEFILTERS ( DimSeason ), DimSeason[Season] = latest ),
			        CALCULATE ( [Avg Auction Price Cr], REMOVEFILTERS ( DimSeason ), DimSeason[Season] = 2013 )
			    )
		formatString: 0.0x
		displayFolder: Money
		lineageTag: 327138c8-8422-5524-bf18-79d885d176c8

	measure 'Mega 2025 vs 2013' =
			DIVIDE (
			    CALCULATE ( [Avg Auction Price Cr], REMOVEFILTERS ( DimSeason ), DimSeason[Season] = 2025 ),
			    CALCULATE ( [Avg Auction Price Cr], REMOVEFILTERS ( DimSeason ), DimSeason[Season] = 2013 )
			)
		formatString: 0.0x
		displayFolder: Money
		lineageTag: 76a5bc1e-5416-515c-bdd5-4bffc47fd90a

	measure 'Mega Auction Avg Price Cr' = IF ( SELECTEDVALUE ( DimSeason[IsMegaAuction] ) = TRUE (), [Avg Auction Price Cr] )
		formatString: ₹#,0.00 Cr
		displayFolder: Money
		lineageTag: bd339a3b-cb2c-5584-8869-854dabec4b58

	measure 'Spend Matched %' =
			DIVIDE (
			    CALCULATE ( SUM ( FactAuction[PriceCr] ), FactAuction[IsMatched] = TRUE () ),
			    SUM ( FactAuction[PriceCr] )
			)
		formatString: 0.0%
		displayFolder: Money
		lineageTag: 97885308-4b7a-599b-949e-21cddadd6207

	measure 'Base Price Buys' = CALCULATE ( COUNTROWS ( FactAuction ), FactAuction[PriceBracket] = "Base price buy" )
